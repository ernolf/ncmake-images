// SPDX-License-Identifier: MIT
//
// Renovate keeps the pinned build tools current through pull requests: the actions
// by commit SHA, the installer stage of php/Containerfile and hadolint by tag and
// digest. The base images stay tags and are not pinned: each image run resolves
// them to a digest that is part of the inputs fingerprint, so an upstream rebuild
// reaches the published images without a pull request.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  // workflow-updater.yml keeps the workflows ncmake manages and records their
  // hashes in .ncmake-workflows.json; a change by Renovate would mark them as
  // locally modified, and ncmake would stop updating them.
  ignorePaths: [
    ".github/workflows/block-unconventional-commits.yml",
    ".github/workflows/branch-cleanup.yml",
    ".github/workflows/reuse.yml",
    ".github/workflows/workflow-updater.yml",
  ],
  customManagers: [
    {
      // hadolint is an image named in the env of the workflow, which the
      // github-actions manager does not read.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/lint-containerfiles\\.yml$/"],
      matchStrings: ["HADOLINT: (?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      datasourceTemplate: "docker",
    },
  ],
}
