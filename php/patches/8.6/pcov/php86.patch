#
# PHP 8.6 removed INI_BOOL(), INI_INT() and INI_STR() in favour of the
# zend_ini_*_literal() macros. INI_STR() returned a char *, which pcov passes on.

--- a/pcov.c
+++ b/pcov.c
@@ -56,6 +56,13 @@
 #define GC_SET_REFCOUNT(ref, rc) (GC_REFCOUNT(ref) = (rc))
 #endif

+#if PHP_VERSION_ID >= 80600
+/* PHP 8.6 removed INI_BOOL(), INI_INT() and INI_STR(). */
+#define INI_BOOL(name) zend_ini_bool_literal(name)
+#define INI_INT(name) zend_ini_long_literal(name)
+#define INI_STR(name) ((char *) zend_ini_string_literal(name))
+#endif
+
 #define PHP_PCOV_API_ENABLED_GUARD() do { \
 	if (!INI_BOOL("pcov.enabled")) { \
 		return; \
